# Caddy configuration for PBX MPP Config Manager.
#
# Which certificate Caddy serves is decided by PBX_TLS in .env, which is dropped into
# the "tls" line below as it stands:
#
#   PBX_TLS=you@example.com                          Let's Encrypt (ZeroSSL as fallback), renewed automatically
#   PBX_TLS=internal                                 self-signed, from Caddy's own CA
#   PBX_TLS=/certs/fullchain.pem /certs/privkey.pem  your own certificate
#
# In every mode Caddy redirects HTTP to HTTPS and proxies to the app over the internal
# Docker network. See .env.example for what each mode needs.

{$PBX_DOMAIN} {
	tls {$PBX_TLS}

	# The app is reachable only on the internal Docker network.
	reverse_proxy pbx-manager:3000

	# Modest hardening. The app sets no CSP of its own; this one matches what it
	# actually loads (its own assets, plus inline styles and a data: URI QR image).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}
}

# ---------------------------------------------------------------------------
# A genuine Let's Encrypt certificate for a host that is NOT reachable from the
# internet needs DNS-01 validation, which this file does not set up: it takes a
# Caddy image built with your DNS provider's plugin (caddy:builder with, say,
# github.com/caddy-dns/cloudflare) and, in place of the tls line above:
#
#     tls {
#         dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#     }
#
# The simpler route is to obtain the certificate elsewhere (certbot with DNS-01
# needs no inbound access) and use the "your own certificate" mode.
# ---------------------------------------------------------------------------
