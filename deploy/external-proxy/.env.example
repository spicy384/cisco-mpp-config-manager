# Copy to .env and edit before starting:  cp .env.example .env

# The LAN address on this host that the reverse proxy will connect to.
# Not 0.0.0.0 - pick the specific interface, then firewall the port so only the
# proxy's address can reach it.
BIND_IP=192.168.1.50

# Names and IPs the generated certificate should cover. Include whatever the
# proxy actually connects to, otherwise the certificate will not match.
TLS_HOSTS=192.168.1.50,pbx.internal.example.com

# Timezone for change log timestamps.
TZ=UTC
