# Copy to .env and edit before starting:  cp .env.example .env

# The domain this will be served on. Its DNS record must point at this host,
# and ports 80 and 443 must be reachable from the internet for Let's Encrypt
# to validate it.
PBX_DOMAIN=pbx.example.com

# Where Let's Encrypt sends certificate expiry warnings. Optional.
ACME_EMAIL=you@example.com

# Timezone for change log timestamps.
TZ=UTC
