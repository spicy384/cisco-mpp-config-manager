# Copy to .env next to docker-compose.yml and edit before starting.

# The name people will type to reach the app. A domain, an internal host name, or an
# IP address (IP addresses and internal names work with the self-signed mode only).
PBX_DOMAIN=pbx.example.com

# --- Which certificate Caddy serves: keep exactly ONE of the PBX_TLS lines ------------

# 1. Self-signed. Caddy runs its own small certificate authority and issues from it.
#    Works anywhere, with nothing to set up. Browsers warn until you trust Caddy's root
#    certificate, which you can copy out once it is running:
#        docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
#    and import into the browsers or devices that use the app.
PBX_TLS=internal

# 2. Let's Encrypt. Put your email address here; Caddy obtains a trusted certificate
#    and renews it by itself. PBX_DOMAIN must be a real domain whose DNS record points
#    at this host, and inbound TCP 80 and 443 must be reachable from the internet.
#    Use a real address: it is registered with the certificate authority as soon as the
#    container starts. If Let's Encrypt cannot issue, Caddy tries ZeroSSL, its other
#    built-in authority, with the same address.
# PBX_TLS=you@example.com

# 3. Your own certificate. Give the certificate (with its chain) and the private key,
#    as paths inside the container, separated by a space. PBX_CERT_DIR is the folder on
#    this host that is mounted at /certs.
# PBX_TLS=/certs/fullchain.pem /certs/privkey.pem
# PBX_CERT_DIR=./certs
#
#    For certificates kept by certbot, mount the whole of /etc/letsencrypt (the files in
#    "live" are links into "archive", so mounting "live" alone does not work):
# PBX_TLS=/certs/live/pbx.example.com/fullchain.pem /certs/live/pbx.example.com/privkey.pem
# PBX_CERT_DIR=/etc/letsencrypt
#
#    Caddy reads the files when it starts: after renewing, run
#        docker compose restart caddy

# ----------------------------------------------------------------------------------------

# Timezone for change log timestamps.
TZ=UTC

# Which image to run. "latest" follows the main branch; a release number such as 1.0.3
# stays put until you change it.
# PBX_VERSION=latest
