# Optional settings for docker-compose.yml. Copy to .env next to the compose file and
# uncomment what you need; anything left out keeps the default shown.

# Which image to run. "latest" follows the main branch; a release number such as 1.0.3
# stays put until you change it.
# PBX_VERSION=latest

# Timezone for timestamps in the change log and audit log.
# TZ=UTC

# Set true when HTTPS terminates in front of the app (a reverse proxy counts).
# COOKIE_SECURE=

# Whose X-Forwarded-For to believe: your proxy's address or a CIDR, or a hop count.
# TRUST_PROXY=

# Serve HTTPS from the app itself with a generated certificate, and the names it covers.
# TLS_ENABLED=false
# TLS_HOSTS=

# Or your own certificate, mounted into the container (see the volumes section).
# TLS_CERT=
# TLS_KEY=

# false stops the daily check for a newer image.
# UPDATE_CHECK=true
